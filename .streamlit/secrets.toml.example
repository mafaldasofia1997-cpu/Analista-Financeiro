# Copia este ficheiro para .streamlit/secrets.toml (local) OU cola o conteúdo em
# "Advanced settings > Secrets" ao publicar no Streamlit Community Cloud.
# NUNCA faças commit do secrets.toml real (está no .gitignore).

# Obrigatório — chave da Financial Modeling Prep (plano gratuito)
FMP_API_KEY = "cole_aqui_a_sua_key"

# Só o autor edita a carteira e as notas. Escolhe uma palavra-passe forte.
ADMIN_PASSWORD = "escolhe_uma_palavra_passe"

# Persistência online da carteira/notas num GitHub Gist secreto.
# Sem estas duas, a app grava em ficheiros locais (bom para desenvolvimento).
GIST_ID = "id_do_gist"
GITHUB_TOKEN = "github_pat_com_permissao_de_gists_read_and_write"
